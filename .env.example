# GeoSentinel AI — Environment Variables Template
#
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# =============================================================================
# Copernicus Data Space Ecosystem (CDSE)
# =============================================================================

# Your CDSE account credentials (https://dataspace.copernicus.eu/)
CDSE_USERNAME=your_cdse_username@example.com
CDSE_PASSWORD=your_cdse_password

# =============================================================================
# Application Settings
# =============================================================================

# Backend API host and port
API_HOST=0.0.0.0
API_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Storage Paths (override defaults)
# =============================================================================

# Uncomment to override default paths
# DATA_DIR=/path/to/data
# CACHE_DIR=/path/to/cache
# OUTPUTS_DIR=/path/to/outputs
# MODELS_DIR=/path/to/models

# =============================================================================
# Model Settings
# =============================================================================

# Path to a pretrained model checkpoint (optional)
# MODEL_CHECKPOINT_PATH=models/checkpoints/unet_best.pt

# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=INFO
